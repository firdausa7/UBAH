{
  "name": "ubah",
  "version": "0.1.0",
  "description": "Ubah: voice-first Somali SRH companion with closed-loop referrals",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "train": "tsx src/ml/trainCli.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build": "npm run build:web && tsc",
    "migrate": "tsx src/migrateCli.ts",
    "create-admin": "tsx src/createAdmin.ts",
    "lint": "oxlint --deny-warnings src test scripts",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://ubah@127.0.0.1:55432/ubah_test} vitest run",
    "import-content": "tsx src/importContent.ts",
    "eval:stt": "tsx src/ai/sttEval.ts",
    "eval:languages": "tsx --env-file-if-exists=.env scripts/eval-languages.ts",
    "translations": "tsx --env-file-if-exists=.env scripts/translations.ts",
    "demo": "tsx src/demoCli.ts",
    "loadtest": "tsx src/tools/loadtest.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.87.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
