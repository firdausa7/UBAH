# Copy to .env and fill in. With nothing set, Ubah runs fully in mock mode (simulator only).
# Every value is checked at startup; in production Ubah refuses to start until the
# safety- and privacy-critical ones are set, and lists everything that is missing.

# production for a pilot
NODE_ENV=development
PORT=3000
# the public https:// address in production
BASE_URL=http://localhost:3000
# 1 when behind a load balancer / reverse proxy
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Database: leave empty to use embedded Postgres (PGlite) in ./.data. Required in production:
# DATABASE_URL=postgres://user:password@host:5432/ubah
# docker-compose only: password for its Postgres container
# POSTGRES_PASSWORD=

# Privacy keys — REQUIRED in production. Generate each with: openssl rand -hex 32
HASH_SECRET=
ENCRYPTION_KEY=
SESSION_SECRET=

# AI first drafts for translators in the Translation studio (optional; any OpenAI-compatible API).
# Never used to answer girls: approved answers are sent word for word.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Speech-to-text for voice notes: OpenAI (or any OpenAI-compatible server, e.g. a self-hosted Whisper).
# Without a key, voice notes use the mock (development only) and real recordings come back "unclear".
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Below this confidence (0-1) a voice note is "unclear": a worker is told and she is asked to try again or type.
STT_MIN_CONFIDENCE=0.4

# Translation: Google Cloud Translation (Basic, v2). Create an API key restricted to the
# Cloud Translation API. Required in production. Without it (development), a mock marks text instead.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com

# Spoken replies (ElevenLabs). OFF by default. Even when on, only languages with an approved voice
# (ttsVoiceId in src/languages/<lang>.ts) get audio; the text reply is always sent.
VOICE_REPLIES=false
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL=eleven_multilingual_v2

# WhatsApp Cloud API (Meta). With a token set, the app secret and a non-default verify token are required.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_APP_SECRET=

# Africa's Talking SMS (username "sandbox" uses their test environment).
# Required in production: nurse alerts and Dada login codes are sent by SMS.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_WEBHOOK_KEY=choose-a-random-string

# Nurse(s) alerted by SMS for urgent cases, comma-separated. Required in production.
NURSE_ALERT_NUMBERS=

# Behaviour
CHECKIN_DELAY_HOURS=72
PASS_VALID_DAYS=7
# MUST be false in production: only health-partner-approved content is served
ALLOW_DRAFT_CONTENT=true
DADA_PAY_PER_CASE_KES=0
# off by default in production
ENABLE_SIMULATOR=true

# Demo data (clinics + staff logins). Never allowed in production: use npm run create-admin.
SEED_DEMO=true
DEMO_STAFF_PASSWORD=change-me-now

# Staff security
# can be false only outside production
MFA_REQUIRED=true
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_WEBHOOK_PER_MIN=6000
RATE_LIMIT_LOGIN_PER_MIN=10

# Background jobs (Postgres-backed queue)
JOBS_ENABLED=true
JOB_POLL_MS=2000
CHECKIN_SWEEP_MINUTES=15

# M-Pesa B2C (Safaricom Daraja) for Dada payments. Leave empty for mock mode (development only;
# production refuses to "pay" without keys). See README → Dada payments.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# Secret part of the callback URL; at least 24 random characters (openssl rand -hex 16)
MPESA_CALLBACK_TOKEN=

# WhatsApp: approved message templates for messages outside the 24-hour window (see README → WhatsApp).
# Leave empty until Meta approves them: check-ins then go by SMS, and other messages wait for her next message.
WHATSAPP_TEMPLATE_CHECKIN=
WHATSAPP_TEMPLATE_NOTIFY=
# Ubah language : WhatsApp template language code, only for languages with an approved template
WHATSAPP_TEMPLATE_LANGUAGES=en:en
WHATSAPP_MAX_VOICE_MB=10
# Longest SMS part (3 segments = 459 characters); longer answers are split into numbered parts
SMS_PART_CHARS=459

# Monitoring: key for /health/ops (what needs a person's attention). At least 24 random characters.
OPS_KEY=
# Labels every staff page as DEMO DATA (also automatic while demo data exists). Never in production.
DEMO_MODE=false

# Public landing page: how girls reach Ubah. Leave empty until live ("coming soon" is shown).
PUBLIC_SMS_NUMBER=
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_USSD_CODE=
PUBLIC_CONTACT_EMAIL=

# Online: "production" (the real service) or "staging" (a secure TEST version that can run before the
# SMS/WhatsApp accounts exist; labelled TEST VERSION on every page). Only used with NODE_ENV=production.
DEPLOY_STAGE=production
# First admin on a fresh online database (only while no admin exists); must change it at first login.
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=
