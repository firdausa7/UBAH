# Copy to .env and fill in. With nothing set, Ubah runs fully in mock mode (simulator only).

PORT=3000
BASE_URL=http://localhost:3000

# Database: leave empty to use embedded Postgres (PGlite) in ./.data. For the pilot, use real Postgres:
# DATABASE_URL=postgres://user:password@host:5432/ubah

# Privacy keys — REQUIRED in a pilot. Generate with: openssl rand -hex 32
HASH_SECRET=
ENCRYPTION_KEY=
SESSION_SECRET=

# AI (any OpenAI-compatible API: OpenAI, or an open-weight model on vLLM / Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Speech-to-text for voice notes (Whisper, or a self-hosted Somali-tuned model)
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_APP_SECRET=

# Africa's Talking SMS (username "sandbox" uses their test environment)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_WEBHOOK_KEY=choose-a-random-string

# Nurse(s) alerted by SMS for urgent cases, comma-separated
NURSE_ALERT_NUMBERS=

# Behaviour
CHECKIN_DELAY_HOURS=72
PASS_VALID_DAYS=7
# MUST be false in a pilot: only health-partner-approved content is served
ALLOW_DRAFT_CONTENT=true
DADA_PAY_PER_CASE_KES=0
ENABLE_SIMULATOR=true
DEMO_STAFF_PASSWORD=change-me-now
